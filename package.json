    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "docx-preview": "^0.3.7",
    "embla-carousel-react": "8.5.1",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.10",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.530",
    "react": "19.2.1",
    "react-day-picker": "9.8.0",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.60.0",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "latest",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.5.7",
    "xlsx": "^0.18.5"
