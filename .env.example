# Ask Your Document — frontend environment variables

# API Configuration
  # frontend/.env.local
NEXT_PUBLIC_API_URL=http://0.0.0.0:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://0.0.0.0:8000/ws
NEXT_PUBLIC_APP_URL=http://0.0.0.0:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_CLARITY_ID=

# Development
NODE_ENV=development
